# Configuración General
PROJECT_NAME="FastAPI SQLModel API"
API_V1_STR="/api/v1"
ECHO_SQL=False

# ========================================================
# Selección de Base de Datos: "sqlite" o "postgres"
# ========================================================
DB_TYPE="sqlite"

# Opción A: SQLite local
SQLITE_URL="sqlite+aiosqlite:///./fastapi_demo.db"

# Opción B: Render / Neon.com / PostgreSQL
# Pega directamente la cadena de conexión de Render o Neon (también soporta DATABASE_URL)
# Ejemplo:
POSTGRES_URL="postgresql://user:password@host/dbname?sslmode=require"